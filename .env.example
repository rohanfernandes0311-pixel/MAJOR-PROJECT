# Firebase (Vite) client config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Backend
# Credential file expected at config/firebase-service-account.json (backend only).

# JWT
JWT_SECRET=
ENVIRONMENT=production
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
PHONE_HASH_SALT=
OTP_HASH_PEPPER=
DATABASE_URL=

HTTPSMS_FROM_NUMBER=

# Backend-only Citizen current weather (never use a VITE_ prefix)
WEATHERBIT_API_KEY=
EARTHDATA_TOKEN=

# PDF imports: URL imports fail closed unless an exact HTTPS host is allowed.
EXTRACTION_ALLOWED_HOSTS=
# Optional local PDF source root (default: data/landslide_extraction)
EXTRACTION_SOURCE_DIR=
