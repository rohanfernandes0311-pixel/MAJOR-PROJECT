# Explicit comma-separated browser origins; use exact HTTPS origins in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# PostgreSQL/Neon connection; use placeholders and a Neon branch for local migration checks.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Runtime environment; production requires a strong private JWT_SECRET.
ENVIRONMENT=development
# Fallback runtime environment when ENVIRONMENT is unset.
APP_ENV=development
# Random secret of at least 32 bytes; replace this placeholder in local configuration.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
# JWT signing algorithm.
JWT_ALGO=HS256
# Access token lifetime, in minutes.
ACCESS_TOKEN_TTL_MIN=15
# Refresh token lifetime, in days.
REFRESH_TOKEN_TTL_DAYS=7
# Private salt used when hashing phone numbers.
PHONE_HASH_SALT=replace-with-a-random-salt
# Private OTP hashing pepper; defaults to JWT_SECRET when unset.
OTP_HASH_PEPPER=replace-with-a-private-otp-pepper
# OTP validity period, in seconds.
OTP_TTL_SECONDS=300
# Minimum delay between OTP sends, in seconds.
OTP_RESEND_DELAY_SECONDS=30
# Maximum OTP verification attempts per session.
OTP_MAX_ATTEMPTS=5
# Require HTTPS outside allowed local development.
ENFORCE_HTTPS=true
# Permit HTTP requests to localhost during development.
ALLOW_INSECURE_LOCALHOST=true
# Maximum SMS recipients accepted by administrative export/activation flows.
SMS_MAX_RECIPIENTS=25
# OTP provider selection: mock, twilio, msg91, or fast2sms.
SMS_PROVIDER=mock
# Twilio account SID; backend-only credential.
TWILIO_ACCOUNT_SID=
# Twilio authentication token; backend-only credential.
TWILIO_AUTH_TOKEN=
# Twilio SMS sender in E.164 format.
TWILIO_SMS_FROM=
# Optional Twilio WhatsApp sender identity.
TWILIO_WHATSAPP_FROM=
# Optional Twilio WhatsApp destination.
TWILIO_WHATSAPP_TO=
# Telegram bot token; backend-only credential.
TELEGRAM_BOT_TOKEN=
# Telegram destination chat identifier.
TELEGRAM_CHAT_ID=
# MSG91 authentication key; backend-only credential.
MSG91_AUTH_KEY=
# MSG91 sender ID.
MSG91_SENDER_ID=LANDSE
# MSG91 OTP template identifier.
MSG91_TEMPLATE_ID=
# MSG91 route identifier.
MSG91_ROUTE=4
# Fast2SMS API key; backend-only credential.
FAST2SMS_API_KEY=
# Fast2SMS sender ID.
FAST2SMS_SENDER_ID=LANDSE
# Sender number written into a manually exported httpSMS workbook.
HTTPSMS_FROM_NUMBER=
# Weatherbit current-weather API key; backend-only credential.
WEATHERBIT_API_KEY=
# OpenWeather API key for the legacy weather adapter; backend-only credential.
OPENWEATHER_API_KEY=
# WeatherAPI key for its optional provider; backend-only credential.
WEATHERAPI_KEY=
# NASA POWER API endpoint override.
NASA_POWER_ENDPOINT=https://power.larc.nasa.gov/api/temporal/daily/point
# Optional IMD adapter endpoint.
IMD_WEATHER_ENDPOINT=
# Earthdata access token for protected environmental data; backend-only credential.
EARTHDATA_TOKEN=
# Whether the optional legacy simulated weather fallback is allowed.
WEATHER_ALLOW_SIMULATED_FALLBACK=true
# Exact HTTPS hostnames permitted for remote PDF extraction inputs.
EXTRACTION_ALLOWED_HOSTS=
# Local filesystem root permitted for PDF extraction inputs.
EXTRACTION_SOURCE_DIR=data/landslide_extraction
# Optional mesh node identifier; defaults to the host name.
MESH_DEVICE_ID=
# Optional mesh data storage directory.
MESH_STORAGE_DIR=
# Mesh node latitude.
MESH_LAT=0
# Mesh node longitude.
MESH_LON=0
# Mesh communication range, in meters.
MESH_RANGE_M=120
# Mesh node record lifetime, in seconds.
MESH_DEVICE_TTL_SEC=90
# Default mesh message lifetime.
MESH_DEFAULT_TTL=6
# Copernicus Data Space username for the optional download script.
CDSE_USERNAME=
# Copernicus Data Space password; optional script credential.
CDSE_PASSWORD=
# Copernicus Data Space client ID; optional script credential.
CDSE_CLIENT_ID=
# Copernicus Data Space client secret; optional script credential.
CDSE_CLIENT_SECRET=
# Optional feature switches use names such as LANDSENSE_ENABLE_GEE=true.
# Vite backend base URL; place this in web-ui/.env to affect frontend builds.
VITE_API_BASE_URL=http://127.0.0.1:8000
# Firebase browser API key; public configuration, restrict it in Firebase Console.
VITE_FIREBASE_API_KEY=
# Firebase browser auth domain.
VITE_FIREBASE_AUTH_DOMAIN=
# Firebase browser project ID.
VITE_FIREBASE_PROJECT_ID=
# Firebase browser storage bucket.
VITE_FIREBASE_STORAGE_BUCKET=
# Firebase browser messaging sender ID.
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Firebase browser app ID.
VITE_FIREBASE_APP_ID=
# Set false to restore the earlier community-report form and map behavior.
VITE_COMMUNITY_REPORTS_ENHANCED=true
# Set false to disable Kannada/bilingual simulation message templates.
VITE_SIMULATION_MESSAGE_LANGUAGE=true

# Firebase Admin SDK reads config/firebase-service-account.json; never put its contents here.
