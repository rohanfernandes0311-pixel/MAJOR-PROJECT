{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://landsense.local/schemas/verified-non-event-review.schema.json",
  "title": "LandSense reviewed observation record",
  "description": "Schema for candidate observations. It does not create observations or convert unknown status into a negative label.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observation_id",
    "local_record_key",
    "status",
    "latitude",
    "longitude",
    "observation_start_utc",
    "observation_end_utc",
    "evidence",
    "provenance",
    "review"
  ],
  "properties": {
    "observation_id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable identifier assigned by the research ingest, never reused."
    },
    "local_record_key": {
      "type": "string",
      "minLength": 1,
      "description": "Composite local key such as inventory:source-file:source-row; preserves repeated source IDs."
    },
    "source_inventory": {
      "type": ["string", "null"]
    },
    "source_record_id": {
      "type": ["string", "null"],
      "description": "Original identifier exactly as supplied by the source; may repeat."
    },
    "source_file": {
      "type": ["string", "null"]
    },
    "source_row_or_feature_index": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "confirmed_landslide",
        "verified_non_event_for_observed_period",
        "unknown_or_unobserved",
        "requires_review"
      ]
    },
    "latitude": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "longitude": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "crs": {
      "type": "string",
      "const": "EPSG:4326"
    },
    "observation_start_utc": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "observation_end_utc": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "event_id": {
      "type": ["string", "null"]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "source_reference",
        "spatial_coverage",
        "temporal_coverage",
        "resolution_or_search_protocol",
        "coverage_quality",
        "false_negative_risk"
      ],
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "field_survey",
            "historical_imagery_review",
            "official_record_with_coverage_evidence",
            "scientific_stable_ground_dataset",
            "inventory_presence_only"
          ]
        },
        "source_reference": {
          "type": "string",
          "minLength": 1
        },
        "spatial_coverage": {
          "type": "string",
          "minLength": 1
        },
        "temporal_coverage": {
          "type": "string",
          "minLength": 1
        },
        "resolution_or_search_protocol": {
          "type": "string",
          "minLength": 1
        },
        "coverage_quality": {
          "type": "string",
          "enum": ["adequate", "partial", "unknown", "not_applicable"]
        },
        "false_negative_risk": {
          "type": "string",
          "enum": ["low", "moderate", "high", "unknown"]
        },
        "imagery_ids": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_provenance", "created_at_utc", "creator"],
      "properties": {
        "record_provenance": {
          "type": "string",
          "enum": ["real", "synthetic", "simulated", "unverified"]
        },
        "created_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "creator": {
          "type": "string",
          "minLength": 1
        },
        "source_checksum": {
          "type": ["string", "null"]
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_ids", "decision", "confidence", "notes"],
      "properties": {
        "reviewer_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "decision": {
          "type": "string",
          "enum": ["accepted", "rejected", "pending", "adjudication_required"]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "notes": {
          "type": "string",
          "minLength": 1
        },
        "adjudication_reference": {
          "type": ["string", "null"]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {"const": "verified_non_event_for_observed_period"}
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "properties": {
              "coverage_quality": {"enum": ["adequate"]}
            }
          },
          "review": {
            "properties": {
              "decision": {"enum": ["accepted"]}
            }
          }
        }
      }
    }
  ]
}
